# Database
DATABASE_URL="postgresql://coxbeach:coxbeach_dev@localhost:5432/coxbeach"
DB_USER=coxbeach
DB_PASSWORD=coxbeach_dev
DB_NAME=coxbeach

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# API
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# SMS (OTP) – get from provider
SMS_API_KEY=sandbox_sms_key
SMS_SENDER_ID=COXBEACH

# Payment Gateways – SANDBOX keys only
BKASH_APP_KEY=sandbox_bkash_app_key
BKASH_APP_SECRET=sandbox_bkash_secret
BKASH_USERNAME=sandbox_bkash_user
BKASH_PASSWORD=sandbox_bkash_pass
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

NAGAD_MERCHANT_ID=sandbox_nagad_merchant
NAGAD_MERCHANT_PRIVATE_KEY=sandbox_nagad_private_key
NAGAD_BASE_URL=https://api.mynagad.com

SSLCOMMERZ_STORE_ID=sandbox_ssl_store
SSLCOMMERZ_STORE_PASSWORD=sandbox_ssl_pass
SSLCOMMERZ_IS_LIVE=false

# Email (for receipts)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@coxbeach.com.bd

# Pricing (adjust via Admin panel – these are defaults)
VAT_RATE=0.15
PLATFORM_FEE_RATE=0.05
AGENT_COMMISSION_RATE=0.08

# Booking
BOOKING_HOLD_MINUTES=15
AGENT_ATTRIBUTION_HOURS=72

# Settlements
SETTLEMENT_SCHEDULE_CRON=0 9 * * 1

# Encryption (for agent NID)
ENCRYPTION_KEY=32_char_hex_key_change_in_production_0
